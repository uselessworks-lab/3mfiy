{
  "name": "@uselessworks/3mfiy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build --workspaces --if-present",
    "typecheck": "npm run build:core && npm run typecheck --workspaces --if-present",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm test",
    "test:browser": "node tools/browser-test.mjs",
    "cli": "node app/cli/dist/main.js",
    "format": "prettier --write package app tests/*.mjs tools examples docs README.md",
    "build:core": "tsc -p package/tsconfig.json",
    "prepare": "npm run build:core"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.25.10",
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "description": "Create, read, and edit 3MF files for 3D printing.",
  "license": "MIT",
  "author": "useless works",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uselessworks-lab/3mfiy.git"
  },
  "homepage": "https://github.com/uselessworks-lab/3mfiy#readme",
  "bugs": {
    "url": "https://github.com/uselessworks-lab/3mfiy/issues"
  },
  "keywords": [
    "3mf",
    "3d-printing",
    "additive-manufacturing",
    "typescript",
    "bambu-studio",
    "mesh",
    "slicer"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bambu": {
      "types": "./dist/adapters/bambu.d.ts",
      "import": "./dist/adapters/bambu.js"
    }
  },
  "files": [
    "dist",
    "package",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "fflate": "0.8.3",
    "saxes": "6.0.0"
  }
}
