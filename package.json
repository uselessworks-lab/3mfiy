{
  "name": "@uselessworks/3mfiy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "package/*",
    "app/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build -w @uselessworks/3mfiy && npm run typecheck --workspaces --if-present",
    "test": "npm run build && node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm test",
    "test:browser": "node tools/browser-test.mjs",
    "cli": "node app/cli/dist/main.js",
    "format": "prettier --write package/core/src app tests/*.mjs tools examples docs README.md",
    "build:core": "npm run build --workspace=package/core",
    "prepare": "npm run build:core",
    "pack:core": "node -e \"require('node:fs').mkdirSync('artifacts/npm', { recursive: true })\" && npm pack --workspace=package/core --pack-destination=artifacts/npm",
    "pack:git": "node -e \"require('node:fs').mkdirSync('artifacts/git', { recursive: true })\" && npm pack --workspaces=false --pack-destination=artifacts/git"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "esbuild": "0.25.10",
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "description": "Create, read, and edit 3MF files for 3D printing.",
  "license": "MIT",
  "author": "useless works",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uselessworks-lab/3mfiy.git"
  },
  "homepage": "https://github.com/uselessworks-lab/3mfiy#readme",
  "bugs": {
    "url": "https://github.com/uselessworks-lab/3mfiy/issues"
  },
  "keywords": [
    "3mf",
    "3d-printing",
    "additive-manufacturing",
    "typescript",
    "bambu-studio",
    "mesh",
    "slicer"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./package/core/dist/index.js",
  "types": "./package/core/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./package/core/dist/index.d.ts",
      "import": "./package/core/dist/index.js"
    },
    "./bambu": {
      "types": "./package/core/dist/adapters/bambu.d.ts",
      "import": "./package/core/dist/adapters/bambu.js"
    }
  },
  "files": [
    "package/core/dist",
    "package/core/src",
    "package/core/README.md",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "fflate": "0.8.3",
    "saxes": "6.0.0"
  }
}
